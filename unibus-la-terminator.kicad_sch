	(text "R59-R114: 180R 1206 250 mW (LCSC C17924), +5V to bus line; up to 139 mW each with the line held low."
		(exclude_from_sim no)
		(at 86.36 238.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a1ea3751-e2ce-40a4-a9a6-216eefd702ae")
	)
	(text "The connector is suitable for MUD and\nnormal UB. The UB ground lines are all\njust assigned to their MUD signal, and\nthe 20V and BAT signals are left open.\n"
		(exclude_from_sim no)
		(at 19.05 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cce90a02-dfa1-4b9c-8a44-8b4f9869ed6c")
	)
	(text "For original Unibus place a strap on \nthese. DO NOT CONNECT FOR MUD or \nthere's 20V on your LA.."
